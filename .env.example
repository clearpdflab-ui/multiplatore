# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# Server
PORT=8080
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-secret
CORS_ORIGIN=http://localhost:3000

# Database
DB_PATH=./multiplatore.db

# Odds APIs
# NOTE: THE_ODDS_API_KEY verificata = the-odds-api.com (NON odds-api.io).
# odds-api.io e' il servizio scelto per la F4 (free: 500 req/giorno, 2 book/account).
# Le chiavi vivono SOLO lato server (supabase secrets set ODDS_API_IO_KEYS=...)
# qui solo per `supabase functions serve` locale.
THE_ODDS_API_KEY=
ODDS_API_IO_KEYS=
ODDS_API_IO_BOOKIES=
FOOTBALL_DATA_API_KEY=
API_SPORTS_KEY=

# NVIDIA API key for integrate.api.nvidia.com (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
